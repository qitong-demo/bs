# 依赖与构建产物
node_modules/
frontend/dist/
frontend/.tmp-run/
frontend/.tmp-build/
backend/target/

# npm 本地缓存（数百 MB，绝不能入库）
frontend/.npm-cache/
.npm/
.pnpm-store/

# 安装包与拆分包（draw.io 安装程序，150MB+；注意文件名是 draw.io- 带点）
draw.io-*.msi
drawio-*.msi
drawio-msi-parts/

# AI 生成的图片素材（可再生，体积大）
output/imagegen/

# 运行时日志与临时文件
*.log
tmp/
logs/

# 密钥与本地配置（绝不提交）
# 高德 Web 服务 Key 通过环境变量 AMAP_WEB_KEY 注入，只在后端与脚本使用；
# Web 端 Key 与安全密钥放在 frontend/.env.local（浏览器可见，靠域名白名单保护）。
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*